NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3014

# Server-only 32-byte base64url key. Keep the same value across deployments so Quick QR links remain stable.
QUICK_SHARE_TOKEN_KEY=replace_with_server_only_random_32_byte_base64url_key

# Local development only: use Dodo test-mode credentials and test products.
# Production must set DODO_PAYMENTS_ENVIRONMENT=live_mode in its server environment.
# The application refuses test mode in production and refuses live mode elsewhere.
# Server-only: required by billing APIs and signed subscription webhook processing.
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_supabase_service_role_key
# Comma-separated immutable Supabase Auth user UUIDs for /internal/analytics; empty disables access.
SETUVARA_ANALYTICS_ADMIN_USER_IDS=
DODO_PAYMENTS_API_KEY=replace_with_test_mode_api_key
DODO_PAYMENTS_WEBHOOK_KEY=replace_with_test_mode_webhook_signing_key
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Local test-mode product IDs only. Production must use the already configured live IDs.
# Expected prices: Plus $6.99/month or $69/year; Pro $12.99/month or $129/year (USD).
DODO_PLUS_MONTHLY_PRODUCT_ID=pdt_replace_me
DODO_PLUS_YEARLY_PRODUCT_ID=pdt_replace_me
DODO_PRO_MONTHLY_PRODUCT_ID=pdt_replace_me
DODO_PRO_YEARLY_PRODUCT_ID=pdt_replace_me

# Wallet providers are server-only. Keep provider credentials out of NEXT_PUBLIC_* variables.
# Generate a random 32-byte base64url value; it keeps Apple pass update tokens stable across deploys.
WALLET_PASS_AUTH_SECRET=replace_with_server_only_random_32_byte_base64url_key

# Apple Wallet generic pass signing and update service. Supply base64-encoded PEM material.
APPLE_WALLET_PASS_TYPE_ID=pass.com.setuvara.identity
APPLE_WALLET_TEAM_ID=replace_with_apple_team_id
APPLE_WALLET_SIGNER_CERTIFICATE_BASE64=replace_with_base64_encoded_pass_type_certificate
APPLE_WALLET_SIGNER_PRIVATE_KEY_BASE64=replace_with_base64_encoded_pass_type_private_key
APPLE_WALLET_SIGNER_PRIVATE_KEY_PASSPHRASE=replace_with_certificate_passphrase
APPLE_WALLET_WWDR_CERTIFICATE_BASE64=replace_with_base64_encoded_apple_wwdr_certificate
APPLE_WALLET_APNS_KEY_ID=replace_with_apple_apns_key_id
APPLE_WALLET_APNS_PRIVATE_KEY_BASE64=replace_with_base64_encoded_apns_p8_private_key

# Google Wallet Generic Pass. The class must exist and be approved in the issuer account.
GOOGLE_WALLET_ISSUER_ID=replace_with_google_wallet_issuer_id
GOOGLE_WALLET_CLASS_ID=replace_with_approved_generic_class_id
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=replace_with_wallet_service_account_email
GOOGLE_WALLET_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64=replace_with_base64_encoded_service_account_private_key
